{
	"schemaVersion": 1,
	"id": "ifrj_mod",
	"version": "${version}",
	"name": "IFRJ Mod",
	"description": "Um mod com elementos do IFRJ",
	"authors": [
		"carlosbobao, Gabriel Aprigliano"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/frj_mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ModIfrj"
		],
		"client": [
			"com.example.ModIfrjClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}